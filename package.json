{
  "name": "kho-phong-realtime",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --webpack",
    "dev:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1 -OpenBrowser",
    "dev:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1 -Restart -OpenBrowser",
    "dev:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1",
    "build": "node ./node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.84.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.555.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
